{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [
            "cypress"
        ],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",

        "paths": {
            "pages/*": [
                "pages/*"
            ],
            "utils/*": [
                "utils/*"
            ]
        }
    },



    "include": [
        "cypress/**/*.ts",
        "pages/**/*.ts",
        "utils/**/*.ts",
        "cypress.config.ts"
    ]

}