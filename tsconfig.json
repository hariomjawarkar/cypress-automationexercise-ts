{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "types": [
            "cypress"
        ],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "pages/*": [
                "pages/*"
            ],
            "utils/*": [
                "utils/*"
            ]
        }
    },

    "include": [
        "cypress/**/*.ts",
        "pages/**/*.ts",
        "utils/**/*.ts",
        "cypress.config.ts"
    ]

}