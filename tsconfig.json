{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "cypress",
            "node"
        ],
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "strict": false,
        "ignoreDeprecations": "5.0",
        "baseUrl": ".",
        "paths": {
            "pages/*": [
                "pages/*"
            ],
            "utils/*": [
                "utils/*"
            ]
        }
    },
    "include": [
        "cypress/**/*.ts",
        "pages/**/*.ts",
        "utils/**/*.ts",
        "cypress.config.ts"
    ]
}